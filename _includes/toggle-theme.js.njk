setTimeout(() => {
    document.documentElement.classList.remove('no-transition');
}, 0);

function applyTheme(theme) {
    let dataTheme = theme;
    if (theme === "system") {
        const isDarkMode = window.matchMedia("(prefers-color-scheme: dark)").matches;
        dataTheme = isDarkMode ? "dark" : "light";
    }

    try {
        localStorage.setItem("ducnm-blog-theme", theme);
    } catch (e) {
        console.error("Failed to save theme to localStorage:", e);
    }

    document.documentElement.setAttribute("data-theme", theme);
    document.documentElement.style.setProperty('color-scheme', dataTheme);
}

const switchAudio = new Audio('{{ "/sounds/switch.wav" | url }}');

const toggleButton = document.querySelector('.theme-toggle');
if (toggleButton) {
    toggleButton.addEventListener('click', () => {
        switchAudio.currentTime = 0;
        switchAudio.play().catch(() => {});

        const current = document.documentElement.getAttribute("data-theme") || "system";
        let next;

        if (current === "dark") {
            next = "light";
        } else if (current === "light") {
            next = "system";
        } else {
            next = "dark";
        }

        applyTheme(next);
    });
}